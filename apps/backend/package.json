{
  "name": "@rag/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "GULUX_ENV=dev gulux dev --root . --config src/config --tsc",
    "build": "gulux build --root . --config src/config",
    "start": "NODE_ENV=production gulux start --root . --config src/config",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "eval:e2e": "tsx evals/runEndToEndEval.ts",
    "dev:api": "GULUX_ENV=dev gulux dev --root . --config src/config --tsc",
    "dev:eval-worker": "tsx src/workers/evalWorker.ts",
    "start:api": "NODE_ENV=production gulux start --root . --config src/config"
  },
  "dependencies": {
    "@gulux/cli": "^1.25.16",
    "@gulux/gulux": "^4.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@next-ai/fornax-sdk": "^2.4.5",
    "@rag/shared": "workspace:*",
    "@types/pdf-parse": "1.1.5",
    "bullmq": "^5.78.0",
    "dayjs": "^1.11.21",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "mammoth": "1.12.0",
    "markitdown-ts": "^0.0.10",
    "pdf-parse": "2.4.5",
    "pg": "^8.16.3",
    "pgvector": "^0.3.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gulux/style": "^1.0.4",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.15.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3"
  }
}
